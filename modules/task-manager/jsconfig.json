{
  "extends": "../../jsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@life-orchestrator/core-store": [
        "../../packages/core-store/src/index.js"
      ],
      "@life-orchestrator/ui-theme/*": ["../../packages/ui-theme/src/*"]
    },
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
